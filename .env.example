# Runtime
NODE_ENV=development
PORT=4002
SERVICE_NAME=pomodoro-api
LOG_LEVEL=debug
# Set automatically by Vercel's runtime; leave unset elsewhere.
# VERCEL=1

# PostgreSQL (required in production)
DATABASE_URL=postgresql://pomodoro:replace-with-database-password@127.0.0.1:5432/pomodoro
# Optional connection-pool tuning.
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
# Development-only escape hatch for starting without PostgreSQL.
REQUIRE_DB=true
# Optional separate integration-test database.
# TEST_DATABASE_URL=postgresql://pomodoro_test:replace-with-test-password@127.0.0.1:5432/pomodoro_test

# Authentication (required in production; generate distinct values of at least 32 bytes)
JWT_SECRET=replace-with-a-random-access-secret-at-least-32-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-bytes

# Browser origins (comma-separated; HTTPS origins without paths are required in production)
CORS_ORIGINS=http://localhost:3002

# Refresh cookie. Use none/true for a cross-site HTTPS production frontend.
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=false
# REFRESH_COOKIE_DOMAIN=.example.com

# Metrics. METRICS_TOKEN protects /api/metrics and should be at least 32 bytes.
# METRICS_TOKEN=replace-with-a-random-metrics-token-at-least-32-bytes

# Optional Sentry error reporting and tracing
# SENTRY_DSN=https://public-key@organization.ingest.sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1
# RELEASE_VERSION=git-sha-or-release-tag

# Optional web push; configure all three values together.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
