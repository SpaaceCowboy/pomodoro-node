    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "qs": "6.15.3"
  }
